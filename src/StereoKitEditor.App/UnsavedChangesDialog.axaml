<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StereoKitEditor.App.UnsavedChangesDialog"
        Title="Unsaved scene changes"
        Width="560" Height="210"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock Margin="18,16,18,6" FontSize="17" FontWeight="SemiBold" Text="Save changes before closing?" />
    <TextBlock Grid.Row="1" Margin="18,6" VerticalAlignment="Top" TextWrapping="Wrap"
               Text="The open scene has changes that have not been saved. You can save them, discard them, or return to the editor." />
    <Border Grid.Row="2" Padding="12" Background="#20242A" BorderBrush="#363D45" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button MinWidth="90" Click="HandleCancel" Content="Cancel" />
        <Button MinWidth="100" Click="HandleDiscard" Content="Discard" />
        <Button MinWidth="110" Classes="accent" Click="HandleSave" Content="Save" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
