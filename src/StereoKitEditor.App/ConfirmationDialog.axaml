<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StereoKitEditor.App.ConfirmationDialog"
        Width="520" Height="210"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock Margin="18,16,18,6" FontSize="17" FontWeight="SemiBold" Text="{Binding Heading}" />
    <TextBlock Grid.Row="1" Margin="18,6" VerticalAlignment="Top" TextWrapping="Wrap" Text="{Binding Message}" />
    <Border Grid.Row="2" Padding="12" Background="#20242A" BorderBrush="#363D45" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button MinWidth="90" Click="HandleCancel" Content="{Binding CancelLabel}" />
        <Button MinWidth="120" Classes="accent" Click="HandleConfirm" Content="{Binding ConfirmLabel}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
