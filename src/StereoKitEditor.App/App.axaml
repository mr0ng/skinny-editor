<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StereoKitEditor.App.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <Style Selector="Window">
            <Setter Property="Icon" Value="/Assets/SKinny.Editor.ico" />
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
            <Setter Property="Background" Value="#181A1D" />
            <Setter Property="Foreground" Value="#E4E7EB" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#22252A" />
            <Setter Property="BorderBrush" Value="#33373D" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#B9BEC7" />
            <Setter Property="LetterSpacing" Value="0.5" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="#2C3036" />
        </Style>
        <Style Selector="ToggleButton.toolbar">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="#2C3036" />
        </Style>
        <Style Selector="ToggleButton.toolbar:checked">
            <Setter Property="Background" Value="#247AB8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#247AB8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9299A3" />
        </Style>
    </Application.Styles>
</Application>
